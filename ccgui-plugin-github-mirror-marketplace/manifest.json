{
  "id": "github-mirror-marketplace",
  "name": "社区插件市场镜像加速",
  "version": "1.1.1",
  "minAppVersion": "1.0.6",
  "sdkVersion": "^0.3",
  "description": "国内网络下 GitHub 静态资源被拦截、内置插件市场打不开时：按「主地址→JsDelivr CDN→国内镜像」自动回退抓取 community-plugins.json，在社区市场页签浏览并一键下载安装社区插件。",
  "author": "xuchuncheng",
  "repo": "xuchuncheng/ccgui-plugin-github-mirror-marketplace",
  "tier": "js",
  "license": "MIT",
  "permissions": [
    "ui:panel-tab",
    "ui:center-tab",
    "ui:sidebar-entry",
    "ui:command",
    "storage",
    "exec:cmd",
    "exec:node",
    "exec:powershell",
    "exec:pwsh",
    "network:raw.githubusercontent.com",
    "network:cdn.jsdelivr.net",
    "network:ghproxy.net",
    "network:gh-proxy.com",
    "network:github.com"
  ],
  "icon": "docs/icon.svg",
  "keywords": [
    "marketplace",
    "mirror",
    "github",
    "网络",
    "市场",
    "加速"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "bridgeCardEnabled": {
        "type": "boolean",
        "title": "内置市场页引导卡",
        "description": "开启后，在宿主内置市场页加载失败处注入一张跳转引导卡（需读取该页 DOM）。默认关闭——关闭时插件完全不触碰宿主界面。",
        "default": false
      }
    }
  }
}
